POSTGRES_DB=knowledge_rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_local_password
NACOS_AUTH_TOKEN=change-me-to-a-base64-token-at-least-32-bytes
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=security
AI_CHAT_ENABLED=openai
AI_EMBEDDING_ENABLED=openai
# 百炼华北2（北京）OpenAI 兼容地址；其他地域请按官方文档替换
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 只写在本地 .env，不要提交到 Git
AI_API_KEY=replace-with-your-bailian-api-key
AI_CHAT_MODEL=qwen-plus
AI_EMBEDDING_MODEL=text-embedding-v4
AI_EMBEDDING_DIMENSIONS=1024
RAG_JWT_ISSUER=enterprise-knowledge-rag
# 至少 32 字节；本地自行生成，生产环境必须使用密钥管理服务注入
RAG_JWT_SECRET=change-this-local-jwt-secret-at-least-32-bytes
